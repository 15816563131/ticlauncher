<?xml version="1.0" encoding="utf-8"?>
<!-- ColorOS 手表：手电筒（复刻 HeyFlashLight） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/fl_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <!-- 大圆形按钮 -->
        <FrameLayout
            android:id="@+id/fl_toggle"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/fl_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/fl_bg_off" />

            <ImageView
                android:id="@+id/fl_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_app_flashlight"
                android:contentDescription="@null"
                android:alpha="0.5" />
        </FrameLayout>

        <TextView
            android:id="@+id/fl_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="手电筒关闭"
            android:textColor="#FF888888"
            android:textSize="13sp"
            android:fontFamily="@font/oplusans_watch" />

        <TextView
            android:id="@+id/fl_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="点击圆圈开启"
            android:textColor="#FF555555"
            android:textSize="10sp"
            android:fontFamily="@font/oplusans_watch" />
    </LinearLayout>
</FrameLayout>
