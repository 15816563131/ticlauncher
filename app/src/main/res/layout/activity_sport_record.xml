<?xml version="1.0" encoding="utf-8"?>
<!--
  ColorOS 手表：运动记录页（复刻 HeySports sport_five_data_layout.xml）

  官方层级与尺寸（res/layout/sport_five_data_layout.xml + res/values/dimens.xml）：
    SportRoundView(fill)
      ├ head   SportDataA 180x46dp  centerHorizontal  marginTop 36dp (data_ui_top_margin_top_one)
      ├ data1  SportDataB 100x40dp  marginTop 90dp(data_ui_margin_top_five)  marginStart 14.5dp(data_ui_item_margin)
      ├ data2  SportDataB 100x40dp  与 data1 同高(alignTop)  贴 parentEnd  marginEnd 14.5dp
      ├ data3  SportDataC 96x40dp   data1 下方(marginTop 8dp)  marginStart 18.5dp
      ├ data4  SportDataC 96x40dp   与 data3 同高  贴 parentEnd  marginEnd 18.5dp
      └ 分隔线  1dp x 88dp(data_ui_line_height_one)  white_20  centerHorizontal  marginTop 90dp(data_ui_line_margin_top_one)
    SportDataA: 数字 30sp / 描述 12sp；SportDataB、SportDataC: 数字 24sp / 描述 12sp
  这里用 TextView 组合还原 SportDataContainerView 的「数值 + 描述」排布，不自绘。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ff000000">

    <!-- head：距离（SportDataA 180x46，居中，marginTop 36dp） -->
    <LinearLayout
        android:layout_width="180dp"
        android:layout_height="46dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="36dp"
        android:orientation="vertical"
        android:gravity="center">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center|bottom">

            <TextView
                android:id="@+id/rec_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00"
                android:textColor="#ffffffff"
                android:textSize="30sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:fontFamily="@font/oplusans_watch" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="公里"
                android:textColor="#ffffffff"
                android:textSize="12sp"
                android:includeFontPadding="false"
                android:fontFamily="@font/oplusans_watch" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="距离"
            android:textColor="#99ffffff"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:fontFamily="@font/oplusans_watch" />
    </LinearLayout>

    <!-- data1：时长（SportDataB 100x40，左，marginTop 90dp，marginStart 14.5dp） -->
    <LinearLayout
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="90dp"
        android:layout_marginStart="14.5dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/rec_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#ffffffff"
            android:textSize="24sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:fontFamily="@font/oplusans_watch" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="时长"
            android:textColor="#99ffffff"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:fontFamily="@font/oplusans_watch" />
    </LinearLayout>

    <!-- data2：配速（SportDataB，右） -->
    <LinearLayout
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="90dp"
        android:layout_marginEnd="14.5dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/rec_pace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#ffffffff"
            android:textSize="24sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:fontFamily="@font/oplusans_watch" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="配速"
            android:textColor="#99ffffff"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:fontFamily="@font/oplusans_watch" />
    </LinearLayout>

    <!-- data3：心率（SportDataC 96x40，左，marginTop 138dp=90+40+8，marginStart 18.5dp） -->
    <LinearLayout
        android:layout_width="96dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="138dp"
        android:layout_marginStart="18.5dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/rec_heart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#ffffffff"
            android:textSize="24sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:fontFamily="@font/oplusans_watch" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="心率"
            android:textColor="#99ffffff"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:fontFamily="@font/oplusans_watch" />
    </LinearLayout>

    <!-- data4：千卡（SportDataC，右，marginTop 138dp，marginEnd 18.5dp） -->
    <LinearLayout
        android:layout_width="96dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="138dp"
        android:layout_marginEnd="18.5dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/rec_calorie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#ffffffff"
            android:textSize="24sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:fontFamily="@font/oplusans_watch" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="千卡"
            android:textColor="#99ffffff"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:fontFamily="@font/oplusans_watch" />
    </LinearLayout>

    <!-- 分隔线：1dp x 88dp，white_20(#33ffffff)，居中，marginTop 90dp -->
    <View
        android:layout_width="1dp"
        android:layout_height="88dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="90dp"
        android:background="#33ffffff" />

    <!-- 结束（官方 record_main_bottom_view 的 finish_btn 文案「完成」）
         圆屏底部弦宽约 147dp，这里收窄到 140dp 居中，避免两端被屏幕圆角裁掉 -->
    <TextView
        android:id="@+id/rec_finish"
        android:layout_width="140dp"
        android:layout_height="34dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="完成"
        android:textColor="#ff000000"
        android:textSize="16sp"
        android:background="@drawable/hs_sport_start_btn"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/oplusans_watch" />
</FrameLayout>
