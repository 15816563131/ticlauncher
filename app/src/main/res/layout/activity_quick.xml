<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <!-- 顶部：电量 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/battery_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_battery_80"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/battery_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="--%"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 第一行开关 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/toggle_airplane"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/toggle_bg"
                android:gravity="center">

                <ImageView
                    android:id="@+id/icon_airplane"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_icon_airplanemode"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="飞行"
                android:textColor="@color/text_dim"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/toggle_dnd"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/toggle_bg"
                android:gravity="center">

                <ImageView
                    android:id="@+id/icon_dnd"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_icon_dnd"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="勿扰"
                android:textColor="@color/text_dim"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/toggle_theater"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/toggle_bg"
                android:gravity="center">

                <ImageView
                    android:id="@+id/icon_theater"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_icon_theatermode"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="影院"
                android:textColor="@color/text_dim"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/toggle_saver"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/toggle_bg"
                android:gravity="center">

                <ImageView
                    android:id="@+id/icon_saver"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_icon_battery_saver"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="省电"
                android:textColor="@color/text_dim"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第二行开关 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/toggle_bluetooth"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/toggle_bg"
                android:gravity="center">

                <ImageView
                    android:id="@+id/icon_bluetooth"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_qss_bluetooth_disconnected"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="蓝牙"
                android:textColor="@color/text_dim"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/toggle_wifi"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/toggle_bg"
                android:gravity="center">

                <ImageView
                    android:id="@+id/icon_wifi"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_qss_wifi"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="WLAN"
                android:textColor="@color/text_dim"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/toggle_findphone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/toggle_bg"
                android:gravity="center">

                <ImageView
                    android:id="@+id/icon_findphone"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_find_my_phone"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="找手机"
                android:textColor="@color/text_dim"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/toggle_flashlight"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/toggle_bg"
                android:gravity="center">

                <ImageView
                    android:id="@+id/icon_flashlight"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_qss_flashlight"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="手电筒"
                android:textColor="@color/text_dim"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 亮度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageView
            android:id="@+id/brightness_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_brightness"
            android:contentDescription="@null" />

        <SeekBar
            android:id="@+id/brightness_seek"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:max="255"
            android:progressBackgroundTint="@color/item_bg_pressed"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />
    </LinearLayout>

    <!-- 底部：触控锁 / 设置 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="2dp">

        <LinearLayout
            android:id="@+id/action_touchlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_icon_status_touchlock"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="触控锁"
                android:textColor="@color/text_dim"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_gm_settings_24"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="设置"
                android:textColor="@color/text_dim"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
