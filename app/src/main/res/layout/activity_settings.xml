<?xml version="1.0" encoding="utf-8"?>
<!--
  ColorOS 手表：设置（复刻 ClockworkSettings 的 OPPO 定制条目）

  官方条目结构见 res/layout/wear_settings_main_preference.xml + styles.xml：
    HeyTapMainListItemStyle：minHeight 52dp、paddingHorizontal 14dp、
      背景 heytap_common_background（圆角 26dp / #ff202124）
    图标 wear_chip_button_icon_size = 24dp，标题 marginStart 8dp，
      文字 PrimaryTextAppearanceWearButton → wear_material_text_size_button1 = 16sp
  素材取自同 APK（icon）与 sysui（applist_vertical_style），无自绘。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="26dp"
            android:layout_marginBottom="6dp"
            android:text="设置"
            android:textColor="#FFEDEDED"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/oplusans_watch" />

        <!-- 外观 → 表盘 -->
        <LinearLayout
            android:id="@+id/btn_watchface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="4dp"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/hs_setting_item_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_watchface"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:text="表盘"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/oplusans_watch" />
        </LinearLayout>

        <!-- 外观 → 应用视图 -->
        <LinearLayout
            android:id="@+id/btn_list_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="4dp"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/hs_setting_item_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/applist_vertical_style"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:text="应用视图"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/oplusans_watch" />

            <TextView
                android:id="@+id/list_style_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#FFB0B5BF"
                android:textSize="14sp"
                android:fontFamily="@font/oplusans_watch" />
        </LinearLayout>

        <!-- 设为默认启动器 -->
        <LinearLayout
            android:id="@+id/btn_default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="4dp"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/hs_setting_item_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_oplus_launcher"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:text="设为默认启动器"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/oplusans_watch" />
        </LinearLayout>

        <!-- 电池 → 省电与续航 -->
        <LinearLayout
            android:id="@+id/btn_power"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="4dp"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/hs_setting_item_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_icon_battery_saver"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:text="省电与续航"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/oplusans_watch" />
        </LinearLayout>

        <!-- 健康 → 心率自动测量（间隔：连续 / 1 分钟 / 5 分钟 / 10 分钟 / 关闭） -->
        <LinearLayout
            android:id="@+id/btn_hr_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="4dp"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/hs_setting_item_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_app_heartrate"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:text="心率自动测量"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/oplusans_watch" />

            <TextView
                android:id="@+id/hr_interval_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#FFB0B5BF"
                android:textSize="14sp"
                android:fontFamily="@font/oplusans_watch" />
        </LinearLayout>

        <!-- 健康 → 负一屏心率刷新（连续 / 30 秒 / 1 分钟 / 关闭） -->
        <LinearLayout
            android:id="@+id/btn_hr_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="4dp"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/hs_setting_item_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_app_heartrate"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:text="负一屏心率"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/oplusans_watch" />

            <TextView
                android:id="@+id/hr_panel_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#FFB0B5BF"
                android:textSize="14sp"
                android:fontFamily="@font/oplusans_watch" />
        </LinearLayout>

        <!-- 快捷功能 → 控制中心 -->
        <LinearLayout
            android:id="@+id/btn_quick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="4dp"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/hs_setting_item_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_app_settings"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:text="控制中心"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/oplusans_watch" />
        </LinearLayout>

        <!-- 快捷功能 → 退回系统桌面 -->
        <LinearLayout
            android:id="@+id/btn_stock_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="4dp"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/hs_setting_item_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_launcher"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:text="退回系统桌面"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/oplusans_watch" />
        </LinearLayout>

        <!-- 快捷功能 → 系统设置 -->
        <LinearLayout
            android:id="@+id/btn_system_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="4dp"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/hs_setting_item_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_gm_settings_24"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:text="系统设置"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/oplusans_watch" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
