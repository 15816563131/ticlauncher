<?xml version="1.0" encoding="utf-8"?>
<!-- ColorOS 手表：睡眠应用主界面 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:background="#FF000000">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp">
        <ImageView
            android:id="@+id/sleep_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="start|center_vertical"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="@null"
            android:alpha="0.8" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="睡眠"
            android:textColor="#FFEDEDED"
            android:textSize="13sp"
            android:fontFamily="@font/oplusans_watch" />
    </FrameLayout>

    <Space android:layout_width="match_parent" android:layout_height="22dp" />

    <!-- 总时长 -->
    <TextView
        android:id="@+id/sleep_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--"
        android:textColor="#FFFFFFFF"
        android:textSize="56sp"
        android:textStyle="bold"
        android:fontFamily="@font/oplusans_watch" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="小时"
        android:textColor="#FF9A9A9A"
        android:textSize="11sp"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/oplusans_watch" />

    <!-- 分条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="22dp"
        android:orientation="vertical">

        <!-- 浅睡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#FF476CFF" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="浅睡"
                android:textColor="#FFCCCCCC"
                android:textSize="11sp"
                android:fontFamily="@font/oplusans_watch" />
            <TextView
                android:id="@+id/sleep_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- 分钟"
                android:textColor="#FFEDEDED"
                android:textSize="11sp"
                android:fontFamily="@font/oplusans_watch" />
        </LinearLayout>

        <!-- 深睡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#FF1B3F8B" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="深睡"
                android:textColor="#FFCCCCCC"
                android:textSize="11sp"
                android:fontFamily="@font/oplusans_watch" />
            <TextView
                android:id="@+id/sleep_deep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- 分钟"
                android:textColor="#FFEDEDED"
                android:textSize="11sp"
                android:fontFamily="@font/oplusans_watch" />
        </LinearLayout>

        <!-- REM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#FF9B59B6" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="REM"
                android:textColor="#FFCCCCCC"
                android:textSize="11sp"
                android:fontFamily="@font/oplusans_watch" />
            <TextView
                android:id="@+id/sleep_rem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- 分钟"
                android:textColor="#FFEDEDED"
                android:textSize="11sp"
                android:fontFamily="@font/oplusans_watch" />
        </LinearLayout>
    </LinearLayout>

    <Space android:layout_width="match_parent" android:layout_height="14dp" />

    <TextView
        android:id="@+id/sleep_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--"
        android:textColor="#FF52ED44"
        android:textSize="36sp"
        android:textStyle="bold"
        android:fontFamily="@font/oplusans_watch" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="睡眠评分"
        android:textColor="#FF666666"
        android:textSize="10sp"
        android:layout_marginTop="1dp"
        android:fontFamily="@font/oplusans_watch" />
</LinearLayout>
