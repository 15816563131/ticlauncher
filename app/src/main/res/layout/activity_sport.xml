<?xml version="1.0" encoding="utf-8"?>
<!--
  ColorOS 手表：运动（复刻 HeySports 主界面）

  官方 MainActivity 用 ViewPager2，page0 = 运动类型列表（key_extra_is_go_to_sport_list
  -> setCurrentItem(0)），即打开应用默认看到的页面。本页复刻该列表。

  布局与尺寸严格照抄官方 res/layout/main_sport_item_layout.xml + res/values/dimens.xml：
    列表项      高 52dp（paddingVertical 14dp + 图标 24dp），背景 #ff202124 圆角 52dp
                左右外边距 12dp，项间距 4dp
    图标        24dp，官方 shape_sport_icon_bg（亮绿圆 #ff8dd632），内置图标 tint 黑
    名称        16sp，#ffffffff，距图标 6dp，右侧留 35dp
  素材与文案全部取自解包后的 HeySports APK，页面不做任何自绘。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ff000000">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 户外健走 -->
            <LinearLayout
                android:id="@+id/sport_item_walk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="14dp"
                android:layout_marginBottom="4dp"
                android:paddingBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/hs_sport_item_bg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/hs_sport_icon_bg"
                    android:src="@drawable/hs_ic_walking"
                    android:tint="#ff000000"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="35dp"
                    android:text="户外健走"
                    android:textColor="#ffffffff"
                    android:textSize="16sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:fontFamily="@font/oplusans_watch" />
            </LinearLayout>

            <!-- 户外骑行 -->
            <LinearLayout
                android:id="@+id/sport_item_ride"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="14dp"
                android:layout_marginBottom="4dp"
                android:paddingBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/hs_sport_item_bg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/hs_sport_icon_bg"
                    android:src="@drawable/hs_ic_riding"
                    android:tint="#ff000000"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="35dp"
                    android:text="户外骑行"
                    android:textColor="#ffffffff"
                    android:textSize="16sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:fontFamily="@font/oplusans_watch" />
            </LinearLayout>

            <!-- 网球 -->
            <LinearLayout
                android:id="@+id/sport_item_tennis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="14dp"
                android:layout_marginBottom="4dp"
                android:paddingBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/hs_sport_item_bg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/hs_sport_icon_bg"
                    android:src="@drawable/hs_ic_tennis"
                    android:tint="#ff000000"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="35dp"
                    android:text="网球"
                    android:textColor="#ffffffff"
                    android:textSize="16sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:fontFamily="@font/oplusans_watch" />
            </LinearLayout>

            <!-- 羽毛球 -->
            <LinearLayout
                android:id="@+id/sport_item_badminton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="14dp"
                android:layout_marginBottom="4dp"
                android:paddingBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/hs_sport_item_bg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/hs_sport_icon_bg"
                    android:src="@drawable/hs_ic_badminton"
                    android:tint="#ff000000"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="35dp"
                    android:text="羽毛球"
                    android:textColor="#ffffffff"
                    android:textSize="16sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:fontFamily="@font/oplusans_watch" />
            </LinearLayout>

            <!-- 篮球 -->
            <LinearLayout
                android:id="@+id/sport_item_basketball"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="14dp"
                android:layout_marginBottom="4dp"
                android:paddingBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/hs_sport_item_bg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/hs_sport_icon_bg"
                    android:src="@drawable/hs_ic_basketball"
                    android:tint="#ff000000"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="35dp"
                    android:text="篮球"
                    android:textColor="#ffffffff"
                    android:textSize="16sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:fontFamily="@font/oplusans_watch" />
            </LinearLayout>

            <!-- 登山 -->
            <LinearLayout
                android:id="@+id/sport_item_climb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="14dp"
                android:layout_marginBottom="4dp"
                android:paddingBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/hs_sport_item_bg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/hs_sport_icon_bg"
                    android:src="@drawable/hs_ic_climb"
                    android:tint="#ff000000"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="35dp"
                    android:text="登山"
                    android:textColor="#ffffffff"
                    android:textSize="16sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:fontFamily="@font/oplusans_watch" />
            </LinearLayout>

            <!-- 椭圆机 -->
            <LinearLayout
                android:id="@+id/sport_item_elliptical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="14dp"
                android:layout_marginBottom="4dp"
                android:paddingBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/hs_sport_item_bg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/hs_sport_icon_bg"
                    android:src="@drawable/hs_ic_elliptical"
                    android:tint="#ff000000"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="35dp"
                    android:text="椭圆机"
                    android:textColor="#ffffffff"
                    android:textSize="16sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:fontFamily="@font/oplusans_watch" />
            </LinearLayout>

            <!-- 瑜伽 -->
            <LinearLayout
                android:id="@+id/sport_item_yoga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="14dp"
                android:layout_marginBottom="4dp"
                android:paddingBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/hs_sport_item_bg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/hs_sport_icon_bg"
                    android:src="@drawable/hs_ic_yoga"
                    android:tint="#ff000000"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="35dp"
                    android:text="瑜伽"
                    android:textColor="#ffffffff"
                    android:textSize="16sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:fontFamily="@font/oplusans_watch" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 返回 -->
    <ImageView
        android:id="@+id/sport_back"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:src="@android:drawable/ic_media_previous"
        android:contentDescription="@null"
        android:alpha="0.8" />
</FrameLayout>
