<?xml version="1.0" encoding="utf-8"?>
<!-- ColorOS 风格卡片页：2x2 快捷入口 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingTop="28dp"
    android:paddingRight="20dp"
    android:paddingBottom="28dp"
    android:gravity="center"
    android:background="#FF000000">

    <!-- 顶部标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:text="卡片"
        android:textColor="#FFEDEDED"
        android:textSize="13sp"
        android:fontFamily="@font/oplusans_watch" />

    <Space android:layout_width="match_parent" android:layout_height="12dp" />

    <!-- 2x2 卡片网格 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <LinearLayout
            android:id="@+id/card_0"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_card_rounded">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/ic_app_sports"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="11dp"
                android:text="运动"
                android:textColor="#FF9A9A9A"
                android:textSize="11sp"
                android:fontFamily="@font/oplusans_watch" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_1"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_card_rounded">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/ic_app_heartrate"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="11dp"
                android:text="心率"
                android:textColor="#FF9A9A9A"
                android:textSize="11sp"
                android:fontFamily="@font/oplusans_watch" />
        </LinearLayout>
    </LinearLayout>

    <Space android:layout_width="match_parent" android:layout_height="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <LinearLayout
            android:id="@+id/card_2"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_card_rounded">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/ic_app_meida_sessions"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="11dp"
                android:text="音乐"
                android:textColor="#FF9A9A9A"
                android:textSize="11sp"
                android:fontFamily="@font/oplusans_watch" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_3"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_card_rounded">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/ic_app_weather"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="11dp"
                android:text="天气"
                android:textColor="#FF9A9A9A"
                android:textSize="11sp"
                android:fontFamily="@font/oplusans_watch" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
