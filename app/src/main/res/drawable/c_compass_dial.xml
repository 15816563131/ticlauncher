<?xml version="1.0" encoding="utf-8"?>
<!-- 简单的罗盘外环：圆环 + N 标记。指南针指针是另一张。
     这里用 shape 画圆环代替原始 drawable，保证纯 XML。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外环 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1AFFFFFF" />
            <stroke android:width="1dp" android:color="#55FFFFFF" />
        </shape>
    </item>
    <!-- 内环装饰 -->
    <item android:top="12dp" android:bottom="12dp" android:left="12dp" android:right="12dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#22FFFFFF" />
        </shape>
    </item>
</layer-list>
