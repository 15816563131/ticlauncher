<?xml version="1.0" encoding="utf-8"?>
<!-- 指南针指针：上半红（北），下半深灰（南），中间白杆 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:viewportWidth="200"
    android:viewportHeight="200"
    android:width="200dp"
    android:height="200dp">

    <!-- 下半：南（深灰） -->
    <path
        android:fillColor="#FF3A3A3A"
        android:pathData="M100,95 L90,100 L100,195 L110,100 Z" />

    <!-- 上半：北（红） -->
    <path
        android:fillColor="#FFED5844"
        android:pathData="M100,95 L90,100 L100,5 L110,100 Z" />

    <!-- 中心圆 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M90,95 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0 Z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M96,95 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />
</vector>
